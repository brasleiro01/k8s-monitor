# Required
ANTHROPIC_API_KEY=sk-ant-...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional — defaults shown
NAMESPACES=                     # comma-separated, empty = watch all namespaces
CLAUDE_MODEL=claude-sonnet-4-6
ERROR_COOLDOWN_SECONDS=300      # seconds before re-alerting on same error
CONTEXT_LINES=10                # log lines captured before each error
LOG_LINES_TAIL=100              # tail lines when first connecting to a pod
POSTMORTEM_DIR=./postmortems
LOG_LEVEL=INFO
