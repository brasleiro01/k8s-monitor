# Obrigatórias
GEMINI_API_KEY=AIza...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Opcionais — valores padrão mostrados
GEMINI_MODEL=gemini-2.0-flash       # gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
NAMESPACES=                         # namespaces separados por vírgula; vazio = todos
ERROR_COOLDOWN_SECONDS=3600         # cooldown (segundos) entre alertas do mesmo erro
MAX_DAILY_ALERTS=5                  # máximo de alertas por erro por dia
CONTEXT_LINES=10                    # linhas de log capturadas antes de cada erro
LOG_LINES_TAIL=100                  # linhas lidas ao conectar num pod pela primeira vez
LOG_LEVEL=INFO

# Para silenciar padrões conhecidos (separados por ||)
# EXCLUDE_LOG_PATTERNS=healthcheck||readiness probe

# Banco de dados Postgres (obrigatório)
# ATENÇÃO: se a senha contiver '@', encode como '%40' na URL de conexão.
# Ex: senha "abc@123" → "abc%40123" na URL, mas "abc@123" na variável POSTGRES_PASSWORD.
DATABASE_URL=postgresql://k8smonitor:senha@localhost:5432/k8smonitor
